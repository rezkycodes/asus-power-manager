    def on_dpi_slider_changed(self, scale):
        if self._mouse_slider_updating or self._updating:
            return
        dpi_val = int(scale.get_value())
        self.mouse_dpi = dpi_val
        self.row_m_dpi.set_subtitle(f"{dpi_val} DPI")
        
        if self._debounce_timer_id is not None:
            GLib.source_remove(self._debounce_timer_id)
        self._debounce_timer_id = GLib.timeout_add(80, lambda: self._apply_mouse_dpi_debounced(dpi_val))

    def _apply_mouse_dpi_debounced(self, dpi_val):
        self._debounce_timer_id = None
        try:
            subprocess.run([get_script_path("battery-mouse-logitech.sh"), "dpi", str(dpi_val)], check=True)
        except Exception:
            pass
        return False

