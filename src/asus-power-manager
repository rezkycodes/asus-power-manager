def get_script_path(name):
    candidates = [
        "/usr/libexec/asus-power-manager/scripts",
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"),
        os.path.dirname(os.path.abspath(__file__)),
        os.path.expanduser("~/bin"),
        os.path.expanduser("~/Development/asus-power-manager/scripts")
    ]
    for d in candidates:
        target = os.path.join(d, name)
        if os.path.isfile(target):
            return target
    return name

def register_lucide_icon_theme():
    candidates = [
        "/usr/share/asus-power-manager/icons/lucide",
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "data", "icons", "lucide"),
        os.path.expanduser("~/Development/asus-power-manager/data/icons/lucide")
    ]
    display = Gdk.Display.get_default()
    if display:
        icon_theme = Gtk.IconTheme.get_for_display(display)
        for c in candidates:
            if os.path.isdir(c):
                icon_theme.add_search_path(c)

