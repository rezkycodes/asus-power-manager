    def load_data(self):
        cmd_status = ["systemctl", "--user", "status", self.unit_name, "--no-pager"] if self.is_user else ["systemctl", "status", self.unit_name, "--no-pager"]
        try:
            res_status = subprocess.run(cmd_status, capture_output=True, text=True)
            out_txt = res_status.stdout + res_status.stderr
            
            active_line = "Unknown"
            pid_line = "N/A"
            mem_line = "N/A"

            for line in out_txt.splitlines():
                line_str = line.strip()
                if line_str.startswith("Active:"):
                    active_line = line_str.replace("Active:", "").strip()
                elif line_str.startswith("Main PID:"):
                    pid_line = line_str
                elif line_str.startswith("Memory:"):
                    mem_line = line_str

            self.row_status.set_subtitle(active_line)
            self.row_resource.set_subtitle(f"{pid_line} • {mem_line}")

            is_running = "active (running)" in active_line or "active (exited)" in active_line
            self.lbl_badge.remove_css_class("badge-running")
            self.lbl_badge.remove_css_class("badge-stopped")
            self.lbl_badge.remove_css_class("badge-failed")

            if is_running:
                self.lbl_badge.set_text("Aktif")
                self.lbl_badge.add_css_class("badge-running")
                self.btn_toggle.set_label("Hentikan (Stop)")
                self.btn_toggle.add_css_class("destructive-action")
            elif "failed" in active_line:
                self.lbl_badge.set_text("Gagal")
                self.lbl_badge.add_css_class("badge-failed")
                self.btn_toggle.set_label("Jalankan (Start)")
                self.btn_toggle.add_css_class("suggested-action")
            else:
                self.lbl_badge.set_text("Mati")
                self.lbl_badge.add_css_class("badge-stopped")
                self.btn_toggle.set_label("Jalankan (Start)")
                self.btn_toggle.add_css_class("suggested-action")
        except Exception as e:
            self.row_status.set_subtitle(f"Error membaca status: {e}")

        cmd_cat = ["systemctl", "--user", "cat", self.unit_name] if self.is_user else ["systemctl", "cat", self.unit_name]
        try:
            res_cat = subprocess.run(cmd_cat, capture_output=True, text=True)
            script_text = res_cat.stdout.strip() if res_cat.stdout else "(Tidak ada script yang ditemukan)"
            self.script_buffer.set_text(script_text)
        except Exception as e:
            self.script_buffer.set_text(f"Gagal membaca script: {e}")

        cmd_logs = ["journalctl", "--user", "-u", self.unit_name, "-n", "20", "--no-pager"] if self.is_user else ["journalctl", "-u", self.unit_name, "-n", "20", "--no-pager"]
        try:
            res_logs = subprocess.run(cmd_logs, capture_output=True, text=True)
            logs_text = res_logs.stdout.strip() if res_logs.stdout else "(Belum ada catatan log)"
            self.logs_buffer.set_text(logs_text)
        except Exception as e:
            self.logs_buffer.set_text(f"Gagal membaca log: {e}")

    def copy_script_to_clipboard(self, btn):
        text = self.script_buffer.get_text(
            self.script_buffer.get_start_iter(),
            self.script_buffer.get_end_iter(),
            True
        )
        clipboard = Gdk.Display.get_default().get_clipboard()
        clipboard.set(text)
        if hasattr(self.parent_win, 'show_toast'):
            self.parent_win.show_toast(f"Script {self.unit_name} disalin ke clipboard!")

    def toggle_service(self):
        cmd_chk = ["systemctl", "--user", "is-active", self.unit_name] if self.is_user else ["systemctl", "is-active", self.unit_name]
        curr = subprocess.run(cmd_chk, capture_output=True, text=True).stdout.strip()
        action = "stop" if curr == "active" else "start"
        cmd = ["systemctl", "--user", action, self.unit_name] if self.is_user else ["sudo", "-n", "systemctl", action, self.unit_name]
        try:
            subprocess.run(cmd, check=True)
            self.load_data()
            if hasattr(self.parent_win, 'update_status'):
                self.parent_win.update_status()
        except Exception as e:
            print(f"Error {action}: {e}")

    def restart_service(self):
        cmd = ["systemctl", "--user", "restart", self.unit_name] if self.is_user else ["sudo", "-n", "systemctl", "restart", self.unit_name]
        try:
            subprocess.run(cmd, check=True)
            self.load_data()
            if hasattr(self.parent_win, 'update_status'):
                self.parent_win.update_status()
        except Exception as e:
            print(f"Error restart: {e}")


class BatteryManagerApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id='com.rezkycodes.BatteryManager',
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        register_lucide_icon_theme()
        apply_custom_css()
        win = self.props.active_window
        if not win:
            win = BatteryManagerWindow(application=self)
        win.present()

