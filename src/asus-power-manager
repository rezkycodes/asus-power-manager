                gpu_temp, gpu_pwr, gpu_used, gpu_tot, gpu_util, gpu_pstate = parts
                gpu_vram = f"{gpu_used}/{gpu_tot} MB"
                gpu_pwr = f"{float(gpu_pwr):.1f} W"
                gpu_temp = f"{gpu_temp}°C"
                gpu_util = f"{gpu_util}%"
        except Exception:
            pass

        self.row_gpu_telemetry.set_subtitle(f"Suhu: {gpu_temp} • Daya: {gpu_pwr} • VRAM: {gpu_vram} • P-State: {gpu_pstate} ({pci_status})")

