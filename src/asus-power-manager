    def update_status(self):
        self._updating = True
        try:
            # 1. Read sysfs power supply
            ac_online = False
            for p in glob.glob("/sys/class/power_supply/*/online"):
                type_file = os.path.join(os.path.dirname(p), "type")
                if os.path.exists(type_file):
                    with open(type_file) as f:
                        if "Mains" in f.read():
                            with open(p) as f_on:
                                ac_online = (f_on.read().strip() == "1")
                            break

            bat_cap = "80"
            bat_status = "Not charging"
            thresh_val = "80"
            
            for p in glob.glob("/sys/class/power_supply/BAT*/capacity"):
                with open(p) as f:
                    bat_cap = f.read().strip()
                break
            for p in glob.glob("/sys/class/power_supply/BAT*/status"):
                with open(p) as f:
                    bat_status = f.read().strip()
                break
            for p in glob.glob("/sys/class/power_supply/BAT*/charge_control_end_threshold"):
                with open(p) as f:
                    thresh_val = f.read().strip()
                break

            # 2. Read UPower
            energy_rate = ""
            health_cap = ""
            time_str = ""
            try:
                bat_path = subprocess.check_output("upower -e | grep BAT | head -1", shell=True, text=True).strip()
                if bat_path:
                    uinfo = subprocess.check_output(f"upower -i '{bat_path}'", shell=True, text=True)
                    for line in uinfo.splitlines():
                        line = line.strip()
                        if line.startswith("energy-rate:"):
                            energy_rate = line.split(":")[1].strip()
                        elif line.startswith("capacity:"):
                            health_cap = line.split(":")[1].strip()
                        elif "time to" in line:
                            time_str = line.split(":")[1].strip()
            except Exception:
                pass

            pct_num = float(bat_cap) if bat_cap.isdigit() else 80.0
            self.level_bar.set_value(pct_num)

            # Titles based on AC and threshold
            self.row_bat.set_title(f"Baterai: {bat_cap}%")
            
            if ac_online:
                if thresh_val == "80" and pct_num >= 79.0:
                    self.row_bat.set_subtitle("🔌 Tersambung Charger — Siaga Penuh (Batas 80% Terpasang)")
                    self.row_drain.set_subtitle("Daya disuplai langsung dari Adaptor (Baterai Standby)")
                elif bat_status.lower() == "charging":
                    target_txt = f" (Target {thresh_val}%)" if thresh_val != "100" else ""
                    self.row_bat.set_subtitle(f"⚡ Mengisi Daya{target_txt}")
                    self.row_drain.set_subtitle(f"{energy_rate if energy_rate else 'Aktif'} (Pengisian)")
                else:
                    self.row_bat.set_subtitle(f"🔌 Tersambung Charger ({bat_status})")
                    self.row_drain.set_subtitle("Adaptor Aktif")
            else:
                self.row_bat.set_subtitle("🔋 Mode Baterai (Tidak Dicas)")
                self.row_drain.set_subtitle(f"{energy_rate if energy_rate else 'Aktif'} (Konsumsi Beban)")

            health_txt = health_cap if health_cap else "Normal"
            est_txt = f" | Estimasi Sisa: {time_str}" if time_str and not ac_online else ""
            self.row_health.set_subtitle(f"Kesehatan Sel: {health_txt}{est_txt}")

            # 3. Update Switch state
            is_80_active = (thresh_val == "80")
            if self.switch_threshold.get_active() != is_80_active:
                self.switch_threshold.set_active(is_80_active)

            # 4. Fan Monitor & Status
            fan1_rpm = "--"
            fan2_rpm = "--"
            for f1 in glob.glob("/sys/devices/platform/asus-nb-wmi/hwmon/hwmon*/fan1_input"):
                with open(f1) as f:
                    fan1_rpm = f.read().strip()
                break
            for f2 in glob.glob("/sys/devices/platform/asus-nb-wmi/hwmon/hwmon*/fan2_input"):
                with open(f2) as f:
                    fan2_rpm = f.read().strip()
                break
            self.row_fan_rpm.set_subtitle(f"CPU Fan: {fan1_rpm} RPM  |  GPU Fan: {fan2_rpm} RPM")

            fan_policy = "0"
            if os.path.exists("/sys/devices/platform/asus-nb-wmi/throttle_thermal_policy"):
                with open("/sys/devices/platform/asus-nb-wmi/throttle_thermal_policy") as f:
                    fan_policy = f.read().strip()
            
            fan_mode_label = "Normal / Balanced (Otomatis)"
            if fan_policy == "1":
                fan_mode_label = "Turbo / Overboost (Pendinginan Cepat)"
            elif fan_policy == "2":
                fan_mode_label = "Silent / Hening (Kecepatan Rendah)"
            self.row_fan_ctrl.set_subtitle(f"Status Aktif: {fan_mode_label}")

            # 5. CPU Info
            gov = ""
            freq_khz = ""
            boost = ""
            if os.path.exists("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"):
                with open("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor") as f:
                    gov = f.read().strip()
            if os.path.exists("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq"):
                with open("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq") as f:
                    freq_khz = f.read().strip()
            if os.path.exists("/sys/devices/system/cpu/cpufreq/boost"):
                with open("/sys/devices/system/cpu/cpufreq/boost") as f:
                    boost = "Aktif" if f.read().strip() == "1" else "Nonaktif"
            
            freq_mhz = int(freq_khz) // 1000 if freq_khz.isdigit() else 0
            
            profile = ""
            if os.path.exists("/sys/firmware/acpi/platform_profile"):
                with open("/sys/firmware/acpi/platform_profile") as f:
                    profile = f.read().strip().capitalize()

            self.row_cpu.set_subtitle(f"Governor: {gov.upper()} @ {freq_mhz} MHz | Turbo: {boost} | Profil: {profile}")

            # 6. GPU Info
            gpu_status = "N/A"
            gpu_file = "/sys/bus/pci/devices/0000:01:00.0/power/runtime_status"
            if os.path.exists(gpu_file):
                with open(gpu_file) as f:
                    gpu_status = f.read().strip().capitalize()
            self.row_gpu.set_subtitle(f"Status Runtime: {gpu_status} (Hemat Daya)")

        except Exception:
            pass
        finally:
            self._updating = False

    def on_threshold_toggled(self, switch_row, gparam):
        if self._updating:
            return
        val = "80" if switch_row.get_active() else "100"
        try:
            subprocess.run(["sudo", "-n", get_script_path("battery-set-threshold.sh"), val], check=True)
            self.show_toast(f"Batas cas baterai diatur ke {val}%")
            self.update_status()
        except Exception as e:
            self.show_toast(f"Gagal mengatur threshold: {e}")

    def set_fan(self, policy):
        mode_names = {"0": "Normal / Balanced", "1": "Turbo / Overboost", "2": "Silent / Hening"}
        try:
            subprocess.run(["sudo", "-n", get_script_path("battery-set-fan.sh"), policy], check=True)
            self.show_toast(f"Mode Kipas Diatur ke: {mode_names.get(policy, policy)}")
            self.update_status()
        except Exception as e:
            self.show_toast(f"Gagal mengubah mode kipas: {e}")

    def set_mode(self, mode):
        cmd = []
        msg = ""
        if mode == "powersave":
            cmd = ["sudo", "-n", get_script_path("battery-save.sh")]
            msg = "⚡ Mode Hemat Daya Berhasil Diaktifkan!"
        elif mode == "performance":
            cmd = ["sudo", "-n", get_script_path("battery-on-ac.sh")]
            msg = "⚡ Mode Performa Penuh Berhasil Diaktifkan!"
        elif mode == "auto":
            cmd = ["sudo", "-n", get_script_path("battery-udev-handler.sh")]
            msg = "⚡ Mode Otomatis Berhasil Diterapkan!"

        try:
            subprocess.run(cmd, check=True)
            self.show_toast(msg)
            self.update_status()
        except Exception as e:
            self.show_toast(f"Gagal mengubah mode: {e}")

    # ── RGB Handlers ───────────────────────────────────────────
    def set_rgb_brightness_level(self, b_val):
        self.rgb_brightness = b_val
        b_labels = {0: "Mati (0%)", 1: "Redup (33%)", 2: "Sedang (66%)", 3: "Terang (100%)"}
        self.row_rgb_bright.set_subtitle(f"Tingkat: {b_labels.get(b_val, str(b_val))}")
        self.apply_rgb_settings()

    def select_rgb_mode(self, mode):
        self.rgb_mode = mode
        mode_names = {"0": "Static", "1": "Breathing", "2": "Color Cycle", "3": "Strobing"}
        self.apply_rgb_settings()
        self.show_toast(f"Efek RGB Diatur ke: {mode_names.get(mode, mode)}")

    def select_rgb_color(self, r, g, b, name):
        self.rgb_r = r
        self.rgb_g = g
        self.rgb_b = b
        self.apply_rgb_settings()
        self.show_toast(f"Warna RGB Diatur ke: {name}")

    def select_rgb_speed(self, speed, label):
        self.rgb_speed = speed
        self.row_rgb_speed.set_subtitle(label)
        self.apply_rgb_settings()
        self.show_toast(f"Kecepatan Efek: {label}")

    def apply_rgb_settings(self):
        try:
            cmd = [
                "sudo", "-n", get_script_path("battery-set-rgb.sh"),
                str(self.rgb_mode),
                str(self.rgb_r),
                str(self.rgb_g),
                str(self.rgb_b),
                str(self.rgb_speed),
                str(self.rgb_brightness)
            ]
            subprocess.run(cmd, check=True)
        except Exception as e:
            self.show_toast(f"Gagal menerapkan RGB: {e}")

def main():
    app = BatteryManagerApp()
    return app.run(sys.argv)

if __name__ == '__main__':
    sys.exit(main())
