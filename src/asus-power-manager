# Script directory resolver
def get_script_path(name):
    candidates = [
        "/usr/libexec/asus-power-manager/scripts",
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts"),
        os.path.dirname(os.path.abspath(__file__)),
        os.path.expanduser("~/bin"),
        os.path.expanduser("~/Development/asus-power-manager/scripts")
    ]
    for d in candidates:
        target = os.path.join(d, name)
        if os.path.isfile(target):
            return target
    return name

def apply_custom_css():
    css = """
    /* Force all icons across the GUI to pure white */
    image, 
    image.dim-label, 
    image.symbolic,
    .image, 
    .icon,
    AdwActionRow image, 
    AdwActionRow .icon, 
    actionrow image, 
    adwactionrow image, 
    row image,
    button image,
    headerbar button image,
    levelbar block {
        color: #ffffff !important;
        -gtk-icon-palette: success #ffffff, warning #ffffff, error #ffffff;
    }

    .action-row-icon,
    AdwActionRow > image:first-child,
    AdwSwitchRow > image:first-child {
        color: #ffffff !important;
    }

    .color-btn {
        border-radius: 9999px;
        min-width: 36px;
        min-height: 36px;
        padding: 0;
        border: 2px solid rgba(255, 255, 255, 0.4);
    }
    .color-btn:checked, .color-btn:active {
        border: 3px solid #ffffff;
    }
    """
    css_provider = Gtk.CssProvider()
    css_provider.load_from_data(css.encode('utf-8'))
    display = Gdk.Display.get_default()
    if display:
        Gtk.StyleContext.add_provider_for_display(
            display,
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

class BatteryManagerApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id='com.rezkycodes.BatteryManager',
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        apply_custom_css()
        win = self.props.active_window
        if not win:
            win = BatteryManagerWindow(application=self)
        win.present()

