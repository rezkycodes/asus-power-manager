class ServiceDetailWindow(Adw.Window):
    def __init__(self, parent_win, unit_name, unit_title, is_user=True):
        super().__init__()
        self.parent_win = parent_win
        self.unit_name = unit_name
        self.is_user = is_user
        
        self.set_title(f"Detail — {unit_name}")
        self.set_default_size(580, 720)
        self.set_modal(True)
        self.set_transient_for(parent_win)

        toolbar_view = Adw.ToolbarView()
        self.set_content(toolbar_view)

        header = Adw.HeaderBar()
        toolbar_view.add_top_bar(header)

        btn_refresh = Gtk.Button(icon_name="lucide-refresh-cw")
        btn_refresh.set_tooltip_text("Segarkan Detail")
        btn_refresh.connect("clicked", lambda b: self.load_data())
        header.pack_end(btn_refresh)

        page = Adw.PreferencesPage()
        toolbar_view.set_content(page)

        # Group 1: Informasi Runtime
        group_info = Adw.PreferencesGroup()
        group_info.set_title(unit_title)
        group_info.set_description(f"Tipe: {'Layanan Pengguna (--user)' if is_user else 'Layanan Sistem (Root)'} • Unit: {unit_name}")
        page.add(group_info)

        self.row_status = Adw.ActionRow()
        self.row_status.set_title("Status Operasional")
        self.row_status.set_subtitle("Memuat...")
        self.row_status.set_icon_name("lucide-server")
        
        self.lbl_badge = Gtk.Label(label="Memuat...")
        self.lbl_badge.add_css_class("badge-stopped")
        self.lbl_badge.set_valign(Gtk.Align.CENTER)
        self.row_status.add_suffix(self.lbl_badge)
        group_info.add(self.row_status)

        self.row_resource = Adw.ActionRow()
        self.row_resource.set_title("Resource & PID")
        self.row_resource.set_subtitle("Memuat...")
        self.row_resource.set_icon_name("lucide-cpu")
        group_info.add(self.row_resource)

        # Group 2: Script Systemd (.service file)
        group_script = Adw.PreferencesGroup()
        group_script.set_title("File Konfigurasi Script Systemd")
        group_script.set_description("Definisi unit file resmi yang dieksekusi oleh systemd")
        
        btn_copy = Gtk.Button(label="Salin Script")
        btn_copy.connect("clicked", self.copy_script_to_clipboard)
        group_script.set_header_suffix(btn_copy)
        page.add(group_script)

        self.script_buffer = Gtk.TextBuffer()
        text_view = Gtk.TextView.new_with_buffer(self.script_buffer)
        text_view.set_editable(False)
        text_view.set_cursor_visible(False)
        text_view.set_monospace(True)
        text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        text_view.add_css_class("code-box")

        scrolled_script = Gtk.ScrolledWindow()
        scrolled_script.set_min_content_height(200)
        scrolled_script.set_max_content_height(280)
        scrolled_script.set_child(text_view)

        row_script = Adw.PreferencesRow()
        row_script.set_child(scrolled_script)
        group_script.add(row_script)

        # Group 3: Log Jurnal
        group_logs = Adw.PreferencesGroup()
        group_logs.set_title("Log Aktivitas Terbaru (Journald)")
        page.add(group_logs)

        self.logs_buffer = Gtk.TextBuffer()
        logs_view = Gtk.TextView.new_with_buffer(self.logs_buffer)
        logs_view.set_editable(False)
        logs_view.set_cursor_visible(False)
        logs_view.set_monospace(True)
        logs_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        logs_view.add_css_class("code-box")

        scrolled_logs = Gtk.ScrolledWindow()
        scrolled_logs.set_min_content_height(140)
        scrolled_logs.set_max_content_height(220)
        scrolled_logs.set_child(logs_view)

        row_logs = Adw.PreferencesRow()
        row_logs.set_child(scrolled_logs)
        group_logs.add(row_logs)

        # Group 4: Kontrol Aksi Layanan
