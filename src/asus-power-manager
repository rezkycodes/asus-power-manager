#!/usr/bin/env /usr/bin/python3
import sys
import subprocess
import os
import glob
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio

# Script directory resolver
SCRIPT_DIR = "/usr/libexec/asus-power-manager/scripts"
if not os.path.isdir(SCRIPT_DIR):
    local_dev = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts")
    if os.path.isdir(local_dev):
        SCRIPT_DIR = local_dev
    else:
        SCRIPT_DIR = os.path.expanduser("~/bin")

def get_script_path(name):
    return os.path.join(SCRIPT_DIR, name)

class BatteryManagerApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id='com.rezkycodes.BatteryManager',
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = BatteryManagerWindow(application=self)
        win.present()

